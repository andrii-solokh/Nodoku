# Copy to .dev.vars for local Stripe testing. Never commit real credentials.
# Leave APP_ORIGIN blank to use the local Vite address (5173 or 4173).
# In Cloudflare production, configure your actual HTTPS site origin explicitly.
APP_ORIGIN=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# One-time permanent ad removal, in USD cents. Empty disables new purchases.
# Set only after choosing the price; existing verified receipts still work.
REMOVE_ADS_AMOUNT=""
# Optional PostHog product analytics. This public project key is delivered to
# the browser through the same-origin /api/analytics-config endpoint.
POSTHOG_PROJECT_API_KEY=""
# Optional country statistics. Keep this server-only query key private; use a
# PostHog project-secret key or a least-privilege personal key with query read
# access. The project ID is shown in PostHog project settings.
POSTHOG_QUERY_API_KEY=""
POSTHOG_PROJECT_ID=""
# US Cloud is the default. Use https://eu.posthog.com for an EU project.
POSTHOG_API_HOST="https://us.posthog.com"
# Optional Google accounts + leaderboard. Enable only after schema setup.
ACCOUNTS_ENABLED="false"
GOOGLE_CLIENT_ID=""
